{
  "name": "memos-cloudflare-worker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply memos-cloudflare --local",
    "db:migrate:remote": "wrangler d1 migrations apply memos-cloudflare --remote"
  },
  "dependencies": {
    "@clerk/backend": "latest",
    "hono": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.12.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "latest"
  }
}
